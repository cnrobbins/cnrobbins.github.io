---
import Img from './Img.astro';
import { previousProjects } from '../data/previousProjects.js';
---

<div class="container project-page-container">
  <h1 class="page-title">Previous Work</h1>

  <!-- Project Summaries Section (projects with a full page get a linked title) -->
  <section class="project-summaries">
    {previousProjects.map((project) => (
      <div class="project-summary-item">
        <div class="project-summary-image">
          <Img
            src={project.image}
            alt={project.imageAlt ?? `${project.title} Project`}
            class={project.darkPanel ? 'dark-panel' : undefined}
            sizes="(max-width: 768px) 80vw, (max-width: 1024px) 85vw, 552px"
          />
        </div>
        <div class="project-summary-content">
          {project.page ? (
            <a href={`/projects/${project.slug}`} class="project-summary-link">
              <h3 class="project-summary-title">{project.title}</h3>
            </a>
          ) : (
            <h3 class="project-summary-title">{project.title}</h3>
          )}
          <p class="project-summary-description">{project.description}</p>
        </div>
      </div>
    ))}
  </section>
</div>
