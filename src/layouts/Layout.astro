---
import '../styles/variables.css';
import '../styles/palettes/blue.css';
import '../styles/palettes/classic.css';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/page-themes/myoassist.css';
import '../styles/page-themes/steep-slopes.css';
import { ACTIVE_PALETTE, PAGE_THEMES, PALETTES, type PageThemeName, type Section } from '../theme.config';
import { PROFILE_LINKS, SITE_DESCRIPTION, SITE_NAME, shareImageUrl } from '../data/site';
import LogoMark from '../assets/logo.svg';

export interface Props {
  title: string;
  description?: string;
  /** Project section a page belongs to; tints its accent (see .section-*). */
  section?: Section;
  /** Page-specific look (see PAGE_THEMES in theme.config.ts). */
  pageTheme?: PageThemeName;
  /** schema.org JSON-LD for search engines (the home page passes the Person graph). */
  structuredData?: object;
}

const { title, description = SITE_DESCRIPTION, section, pageTheme, structuredData } = Astro.props;

// Every page is built as a directory (/projects/), so the canonical URL ends in a slash,
// matching the sitemap.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(path, Astro.site).href;
const shareImage = await shareImageUrl();

const palette = PALETTES[ACTIVE_PALETTE];
const paletteDark = 'themeColorDark' in palette ? palette.themeColorDark : undefined;
const hasDarkMode = Boolean(paletteDark);
const themeColor = pageTheme
  ? PAGE_THEMES[pageTheme].themeColor
  : section ? palette.sectionColors[section] : palette.themeColor;
const themeColorDark = pageTheme && hasDarkMode ? PAGE_THEMES[pageTheme].themeColorDark : paletteDark;
const htmlClass = [section && `section-${section}`, pageTheme && `theme-${pageTheme}`].filter(Boolean).join(' ') || undefined;
// Built from the logo in the page's colors (src/pages/favicons/[name].svg.ts).
const faviconHref = `/favicons/${pageTheme ?? ACTIVE_PALETTE}.svg`;
---

<!DOCTYPE html>
<html
  lang="en"
  data-palette={ACTIVE_PALETTE}
  data-dark-mode={hasDarkMode ? '' : undefined}
  class={htmlClass}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Link previews (LinkedIn, Slack, iMessage, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary" />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <meta name="theme-color" content={themeColor} data-light={themeColor} data-dark={themeColorDark} />
    <meta name="color-scheme" content={hasDarkMode ? 'light dark' : 'light'} />

    <!-- Runs before first paint so the page never flashes the wrong theme:
         a saved choice wins, otherwise follow the system setting. -->
    <script is:inline>
      (() => {
        if (!document.documentElement.hasAttribute('data-dark-mode')) return;
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && meta.dataset[theme]) meta.content = meta.dataset[theme];
      })();
    </script>

    <!-- Icons, all made from src/assets/logo.svg: modern browsers show the SVG in
         this page's colors. favicon.ico and apple-touch-icon.png are raster
         fallbacks (scripts/make-favicons.mjs).
         sizes="32x32" stops Chrome from preferring the .ico over the SVG. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <!-- Loading screen (shown once per browser session; see app.js) -->
    <div class="loading-screen" id="loading-screen">
      <img src="/assets/skeleton_walking_v2.gif" alt="" />
    </div>

    <nav class="nav" id="nav">
      <div class="nav-brand">
        <a href="/" class="nav-logo" aria-label={`${SITE_NAME}, home`}>
          <LogoMark class="nav-logo-mark" aria-hidden="true" />
        </a>
      </div>
      <ul class="nav-links">
        <li><a href="/#hero" class="nav-link">Home</a></li>
        <li><a href="/#about" class="nav-link">About</a></li>
        <li><a href="/projects" class="nav-link">Projects</a></li>
        <li><a href="/#contact" class="nav-link">Contact</a></li>
      </ul>
      {/* Dark-mode toggle (its visible word is the mode it switches to). Palettes
          without dark mode get an empty column that balances .nav-brand so the
          links sit centered. */}
      {hasDarkMode ? (
        <div class="nav-actions">
          <button type="button" class="theme-toggle" data-theme-toggle>
            <span class="sr-only">Switch to</span>
            <span class="theme-toggle-dark">Dark</span>
            <span class="theme-toggle-light">Light</span>
            <span class="sr-only">mode</span>
          </button>
        </div>
      ) : (
        <div class="nav-spacer" aria-hidden="true"></div>
      )}
    </nav>

    <main class="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-content">
        <p>&copy; {new Date().getFullYear()} {SITE_NAME}</p>
        <div class="footer-links">
          {PROFILE_LINKS.map((link) => (
            <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
          ))}
          <a href="mailto:robbins.cal@northeastern.edu">Email</a>
        </div>
      </div>
    </footer>

    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="../scripts/app.js"></script>
  </body>
</html>
