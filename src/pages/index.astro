---
import Layout from '../layouts/Layout.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import AboutPhotos from '../components/AboutPhotos.astro';
import { personStructuredData } from '../data/site';
---

<Layout title="Calder Robbins - Biomechanics & Robotics Researcher" structuredData={await personStructuredData()}>
  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="hero-content">
      <div class="hero-text">
        {/* The name is the page's h1 so search engines read this as Calder Robbins's page.
            Both elements are styled only by class, so swapping the tags looks identical. */}
        <h1 class="hero-name">Calder Robbins</h1>
        <p class="hero-title">
          <span class="hero-line">
            <span class="hero-word" data-text="Biomechanics">Biomechanics</span>
            <span class="hero-word" data-text="& Robotics">& Robotics</span>
          </span>
          <span class="hero-line">
            <span class="hero-word" data-text="Researcher">Researcher</span>
          </span>
        </p>
        <p class="hero-subtitle">
          Design, control, and simulation of wearable robots for human mobility
        </p>
      </div>
      <div class="hero-visual">
        <img src="/assets/skeleton_walking_v2.gif" alt="Animated walking skeleton" />
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-content">
        <div class="about-text">
          <h2 class="section-title" data-text="About Me">About Me</h2>
          <div class="about-description">
            <p class="fade-in">
              I'm a graduate researcher in Northeastern University's NeuMove Laboratory, advised by Prof. Seungmoon Song, where my work focuses on the design, control, and simulation of wearable robotics. My thesis centers on advancing ankle exoskeleton design and control, combining hardware development, musculoskeletal modeling, and ML control frameworks.
            </p>
            <p>
              My path to wearable robotics started in biomechanics. I earned my B.S. in Biomedical Engineering (2023) and M.S. in Mechanical Engineering (2024) at UMass Amherst, studying performance running footwear with Prof. Wouter Hoogkamer and developing variable stiffness footwear with Prof. Meghan Huber.
            </p>
            <p>
              Outside the lab, I'm an avid wildlife photographer and spend as much time as I can biking, hiking with my two dogs, or listening to records with my cat.
            </p>
          </div>
        </div>
        <!-- Photo: placed here so mobile order is description → photo → skills → CV -->
        <div class="about-visual">
          <AboutPhotos />
        </div>
        <div class="about-bottom">
          <div class="about-skills">
            <div class="skill-category">
              <h3>Programming</h3>
              <ul>
                <li>Python</li>
                <li>MATLAB</li>
              </ul>
            </div>
            <div class="skill-category">
              <h3>Modeling</h3>
              <ul>
                <li>SolidWorks</li>
                <li>MuJoCo</li>
              </ul>
            </div>
            <div class="skill-category">
              <h3>Experimental</h3>
              <ul>
                <li>Motion Capture</li>
                <li>EMG</li>
                <li>OpenSim</li>
                <li>MyoSuite</li>
              </ul>
            </div>
            <div class="skill-category">
              <h3>Design</h3>
              <ul>
                <li>Adobe Creative Suite</li>
              </ul>
            </div>
          </div>
          <a href="/assets/CR_CV.pdf" target="_blank" rel="noopener noreferrer" class="btn btn--secondary" style="margin-top: 2rem;">
            Download CV
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Preview -->
  <section class="projects-preview" id="projects">
    <div class="container">
      <h2 class="section-title" data-text="Featured Work">Featured Work</h2>

      <FeaturedCarousel />

      <div class="projects-nav">
        <a href="/projects#current-work" class="projects-nav-link">Current Work</a>
        <a href="/projects#papers-and-presentations" class="projects-nav-link">Papers &amp; Presentations</a>
        <a href="/projects#previous-work" class="projects-nav-link">Previous Work</a>
      </div>

      <div class="projects-cta">
        <a href="/projects" class="btn btn--primary">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="contact-cta" id="contact">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Contact Me</h2>
        <a href="mailto:robbins.cal@northeastern.edu" class="btn btn--primary btn--large">Email</a>
      </div>
    </div>
  </section>
</Layout> 