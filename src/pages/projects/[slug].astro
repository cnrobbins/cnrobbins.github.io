---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import ProjectPage from '../../components/ProjectPage.astro';
import { currentProjects } from '../../data/currentProjects.js';
import { previousProjects } from '../../data/previousProjects.js';

// Every Current Work project gets a page (a placeholder until it has `page`
// data); a Previous Work project gets one only once it has `page` data.
export function getStaticPaths() {
  return [
    ...currentProjects.map((project) => ({
      params: { slug: project.slug },
      props: { project, section: 'current' as const },
    })),
    ...previousProjects
      .filter((project) => project.page)
      .map((project) => ({
        params: { slug: project.slug },
        props: { project, section: 'previous' as const },
      })),
  ];
}

const { project, section } = Astro.props;
const backLink =
  section === 'previous'
    ? { href: '/projects#previous-work', label: 'Back to Previous Work' }
    : { href: '/projects#current-work', label: 'Back to Current Work' };
---

<Layout
  title={`${project.title} - Calder Robbins`}
  description={project.blurb}
  section={section}
  pageTheme={project.page?.theme}
>
  {project.page ? (
    <ProjectPage project={{ ...project, page: project.page }} backLink={backLink} />
  ) : (
    <div class="container project-page-container project-detail">
      <a href={backLink.href} class="project-back-link">{backLink.label}</a>

      <h1 class="page-title">{project.title}</h1>

      <div class="project-detail-image">
        <Img src={project.image} alt={project.title} sizes="(max-width: 768px) 70vw, 560px" loading="eager" />
      </div>

      <p class="project-summary-description">{project.description}</p>

      <div class="project-detail-placeholder">
        <h2>More coming soon!</h2>
        <p>Detailed write-ups, figures, and results for this project are on the way. Check back soon.</p>
      </div>
    </div>
  )}
</Layout>
